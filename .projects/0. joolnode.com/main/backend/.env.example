# JOOLnode Express API 환경변수 예시
# 실제 값은 Render Dashboard 또는 .env 파일에 설정

PORT=4000

# Cloudflare R2 설정 (https://cloudflare.com/imagine)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET_NAME=joolnode
R2_PUBLIC_URL=https://cdn.joolnode.com

# CSP(Content-Security-Policy) connect-src 허용 도메인
# 프론트엔드에서 API로의 연결을 허용할 도메인 목록 (공백 구분)
CSP_CONNECT_SRC=https://joolnode.com https://blog.joolnode.com
